<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Never back up the Realm cache or auth-adjacent prefs; both are re-fetched
         on a fresh install and restoring them across devices would carry a device
         identity that the backend has not linked. -->
    <exclude domain="database" path="zillit-v3.realm" />
    <exclude domain="sharedpref" path="zillit_prefs" />
</full-backup-content>
